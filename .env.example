# On Vercel: copy these into Project → Settings → Environment Variables.
# On a VPS: copy this file to /etc/call-harbison.env (see docs/VPS.md) and fill it in. One KEY=value per line,
# no spaces around "=", and double quotes around a value that contains spaces.
# Configure at least one lead destination.

# Production URL (canonical links + sitemap). Optional — defaults to https://www.callharbison.com.
# Bare values like "callharbison.com" are normalized to https://www.callharbison.com.
SITE_URL=https://www.callharbison.com

# Email alerts via Resend (resend.com). LEAD_NOTIFY_EMAIL can be comma-separated.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=nate85.realtor@gmail.com,coaiebay@gmail.com
# Must be on a domain verified in Resend, e.g. "Harbison Leads <leads@callharbison.com>"
LEAD_FROM_EMAIL=

# Store leads in Neon (recommended). Use the pooled connection string from the Neon console. Server-side only.
# When DATABASE_URL is set, it takes over and the two Supabase values below are ignored.
DATABASE_URL=

# Or store leads in Supabase (run supabase/schema.sql first). Server-side only — never expose this key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Forward leads to Zapier / Make / GoHighLevel / CRM (for SMS alerts, follow-up automations, etc.)
LEAD_WEBHOOK_URL=

# Google Analytics 4 (optional)
GA_MEASUREMENT_ID=

# Google Tag Manager (recommended over raw GA4 once Ads conversions + call tracking are added)
GTM_ID=

# Metricool tracker hash (optional). Without it the account's built-in hash is used, unless ANALYTICS_DEFAULTS=off.
METRICOOL_HASH=

# Instant text to the lead + staff alert (Twilio). Requires A2P 10DLC registration before US texting works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Comma-separated staff numbers to alert on every new lead
LEAD_ALERT_SMS=

# HQ panel at /hq (dashboard + CRM). Use a long, unique password; changing it signs everyone out.
HQ_PASSWORD=
# Optional: separate secret for signing HQ sessions (otherwise derived from HQ_PASSWORD + service key)
HQ_SESSION_SECRET=

# Private server-to-server intake from Harbison Standard. Same secret as SHARED_CRM_SECRET there.
CRM_INGEST_SECRET=
# Customer SMS acknowledgments stay off until wording and sending conditions are approved.
LEAD_ACK_ENABLED=false

# Seller operations draft. Enable only after the reviewed migration exists in an isolated environment.
SELLER_OPERATIONS_ENABLED=false
# Manual internal email worker; OFF unless dispatch has been separately approved.
SELLER_OUTBOX_DISPATCH_ENABLED=false
# Separate reviewer capability for imports/reviews/links/reconciliation. No production value provisioned.
HQ_REVIEW_PASSWORD=

# ---- VPS only (server.mjs). Leave these out on Vercel. ----
# Where the Node app listens. Keep it on 127.0.0.1 and let Caddy or nginx face the internet.
#PORT=3000
#HOST=127.0.0.1
# Who may tell the app a visitor's address: "loopback" (a proxy on this machine, the default),
# "private" (also a proxy on a private network, such as Docker), or "off" (no proxy in front).
#TRUST_PROXY=loopback
# Vercel Web Analytics and Speed Insights only exist on Vercel. Off keeps their scripts out of the pages.
#VERCEL_INSIGHTS=off
# Site analytics stored on this server instead of the shared Harbison Standard collector. HQ reads them from here.
# Needs a writable folder, so never on Vercel. See docs/VPS.md, "Site analytics".
#ANALYTICS_STORE=local
# Where they are kept. Default: $STATE_DIRECTORY/analytics (/var/lib/call-harbison/analytics with the systemd unit),
# else ./.data/analytics.
#ANALYTICS_DIR=
# Key for the daily visitor hash. Leave empty to have one created in the data folder (mode 0600) on first use.
#ANALYTICS_SECRET=
# Build setting. Off: Google Analytics and Metricool load only with GA_MEASUREMENT_ID and METRICOOL_HASH above,
# never with the built-in defaults. Needs a deploy (rebuild) to take effect.
#ANALYTICS_DEFAULTS=off
