# The site's settings. On the server this file is /etc/call-harbison.env (see docs/VPS.md, step 4).
# One KEY=value per line, no spaces around "=", and double quotes around a value that contains spaces.
# Only SITE_URL and HQ_PASSWORD are needed. Leads are kept in the site's own database on the server.

# ---- Needed ----

# The site's address (links, sitemap, search engines). "callharbison.com" is read as https://www.callharbison.com.
SITE_URL=https://www.callharbison.com
# The password for /hq (dashboard + CRM). At least 12 characters, long and unique: with a shorter one HQ stays off.
# Changing it signs everyone out.
HQ_PASSWORD=

# ---- Email alerts (optional): an email for every new lead, sent through Resend (resend.com) ----
# Both RESEND_API_KEY and LEAD_NOTIFY_EMAIL are needed; without either, no e-mail is sent (leads still reach HQ).
RESEND_API_KEY=
# Who gets them, comma-separated: Nathanael's address and that of anyone else who answers new leads. There is no
# default: left empty, nobody is e-mailed.
LEAD_NOTIFY_EMAIL=
# The sender, on a domain verified in Resend, e.g. "Harbison Leads <leads@callharbison.com>"
LEAD_FROM_EMAIL=

# ---- Measurement tools (optional). Each loads only when set, and only after the visitor accepts. ----
# Changing these needs a deploy (the pages are rebuilt).
GA_MEASUREMENT_ID=
GTM_ID=
METRICOOL_HASH=
# HQ on an address of its own, e.g. hq.callharbison.com (a DNS name pointing at this server, and a Caddy site for
# it). Then /hq works only there and every public page answers 404 there, so the measurement tools above can never
# run beside the staff sign-in. Recommended as soon as one of them is set. Empty: HQ stays at SITE_URL/hq.
HQ_HOST=

# ---- Other connections (optional) ----
# Send each lead as JSON to Zapier / Make / GoHighLevel.
LEAD_WEBHOOK_URL=
# Optional: each webhook post then carries X-Call-Harbison-Signature: sha256=<HMAC-SHA256 of the body with this
# secret>, so the receiver can check it came from this site. Make one with `openssl rand -hex 32`.
LEAD_WEBHOOK_SECRET=
# Text alerts through Twilio. Requires A2P 10DLC registration before US texting works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Comma-separated staff numbers to text on every new lead
LEAD_ALERT_SMS=
# Customer SMS acknowledgments stay off until wording and sending conditions are approved.
LEAD_ACK_ENABLED=false
# When they are on: at most this many a day (Bakersfield date), so fake leads cannot text strangers without end.
#LEAD_ACK_DAILY_MAX=30
# Private intake from Harbison Standard into HQ, and its stats tab. Same secret as SHARED_CRM_SECRET there.
CRM_INGEST_SECRET=
# Read-only MCP connection for an AI assistant such as Grok (docs/MCP.md). Off until set; 32+ characters:
# make one with `openssl rand -hex 32`.
MCP_TOKEN=
# "on" also gives the assistant sellers' names, phone numbers, e-mail, addresses and notes, which then go to its
# provider (xAI). Leave empty unless the owner has decided to share them.
MCP_CONTACT_DETAILS=

# ---- "Ask a question": answers visitors' questions with this website's own text (docs/ASSISTANT.md) ----
# Off unless ASSISTANT=on. Changing ASSISTANT or ASSISTANT_PROVIDER_NAME needs a deploy (the pages are rebuilt).
ASSISTANT=
# The company the privacy page names as receiving questions; the same at build and run time. Empty: questions
# never leave the server and the site's own search picks the answer.
ASSISTANT_PROVIDER_NAME=
# Server only, never in a page: a chat-completions service that helps pick the answer. Empty: search only.
ASSISTANT_API_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
# Model calls a day for the whole site (default 500; 0 keeps the model off).
#ASSISTANT_DAILY_MAX=500

# ---- Switches: leave these as they are ----
# Seller operations draft. Enable only after the reviewed migration exists in an isolated environment.
SELLER_OPERATIONS_ENABLED=false
# Manual internal email worker; OFF unless dispatch has been separately approved.
SELLER_OUTBOX_DISPATCH_ENABLED=false
# Separate reviewer capability for imports/reviews/links/reconciliation. No production value provisioned.
HQ_REVIEW_PASSWORD=

# ---- Rarely needed ----
# Where the app listens. Keep it on 127.0.0.1 and let Caddy face the internet.
#PORT=3000
#HOST=127.0.0.1
# Who may tell the app a visitor's address: "loopback" (Caddy on this machine, the default),
# "private" (also a proxy on a private network, such as Docker), or "off" (no proxy in front).
#TRUST_PROXY=loopback
# Your own key for signing HQ sign-ins and thank-you links, instead of the generated
# /var/lib/call-harbison/signing-key. At least 32 characters (`openssl rand -hex 32`); a shorter one is ignored.
#HQ_SESSION_SECRET=
# Keep the database or the visitor statistics somewhere other than /var/lib/call-harbison.
#DATABASE_DIR=
#ANALYTICS_DIR=
# Key for the daily visitor hash in the statistics. Empty: one is created in the statistics folder.
#ANALYTICS_SECRET=
# Browser origins allowed to call /api/mcp besides SITE_URL's, comma-separated. Servers send none.
#MCP_ALLOWED_ORIGINS=
