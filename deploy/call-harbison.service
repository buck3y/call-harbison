# systemd unit for the Call Harbison website. Install as /etc/systemd/system/call-harbison.service
# See docs/VPS.md. The app listens on 127.0.0.1 only; Caddy is the public face.
[Unit]
Description=Call Harbison website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=callharbison
Group=callharbison
# "current" is a symlink that deploy/deploy.sh points at the newest release.
WorkingDirectory=/srv/call-harbison/current
EnvironmentFile=/etc/call-harbison.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server.mjs
# The one writable folder: /var/lib/call-harbison, passed to the app as STATE_DIRECTORY. It holds the database (db/),
# its daily backups (backups/), the HQ signing key and the site analytics (analytics/). Deploys and restarts leave it
# alone. The app closes the database cleanly on stop; TimeoutStopSec leaves it time to.
StateDirectory=call-harbison
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

# The app only reads its own files and talks to the network, so it gets nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
# Other users' processes are hidden. Not ProcSubset=pid: the database lock reads /proc/sys/kernel/random/boot_id.
ProtectProc=invisible
RestrictRealtime=true
# Only the system calls an ordinary service makes (this includes starting the one short-lived node child that creates
# the database, and fsync). A call outside the list fails with EPERM instead of killing the process, so Node can fall
# back (it tries io_uring, for example). Not MemoryDenyWriteExecute: V8 and the WebAssembly database need it.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Files the app creates (database, backups, statistics, signing key) are readable by the app user only.
UMask=0077
# The deploy key and the git clone are the deploy script's business, not the running app's.
InaccessiblePaths=-/srv/call-harbison/.ssh -/srv/call-harbison/repo
# If the service does not start after a change here, see docs/VPS.md ("If the site does not start").

[Install]
WantedBy=multi-user.target
